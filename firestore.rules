rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isChatParticipant(chatId) {
      return request.auth != null
        && request.auth.uid in get(
          /databases/$(database)/documents/chats/$(chatId)
        ).data.participant_uids;
    }

    match /chats/{chatId} {
      // List queries must filter participant_uids by the authenticated UID.
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participant_uids;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        allow write: if false;
      }
    }

    // All other collections remain accessible only through the backend.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
